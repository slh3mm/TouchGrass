# Safe, non-production defaults. scripts/uat/Setup-Uat.ps1 creates a private
# .env.uat.local with randomly generated secrets before starting UAT.

PUBLIC_SERVER_URL=http://server:8000
ORIGIN=http://localhost:8115
FRONTEND_URL=http://localhost:8115
PUBLIC_URL=http://localhost:8116
CSRF_TRUSTED_ORIGINS=http://localhost:8115,http://localhost:8116
ALLOWED_HOSTS=localhost,127.0.0.1,server
FRONTEND_PORT=8115
BACKEND_PORT=8116
BODY_SIZE_LIMIT=Infinity

PGHOST=db
PGPORT=5432
POSTGRES_DB=touchgrass_uat
POSTGRES_USER=touchgrass_uat
POSTGRES_PASSWORD=uat-example-only
SECRET_KEY=uat-example-only
DEBUG=False
DISABLE_REGISTRATION=False

UAT_MODE=true
UAT_MOCK_INTEGRATIONS=true
UAT_ALLOW_EXTERNAL_INTEGRATIONS=false
UAT_ANCHOR_DATE=2026-08-11
UAT_OWNER_PASSWORD=uat-example-only
UAT_MEMBER_PASSWORD=uat-example-only
UAT_OUTSIDER_PASSWORD=uat-example-only
UAT_EMPTY_PASSWORD=uat-example-only

ICLOUD_PHOTOS_MOUNT=/icloud-photos
PHOTO_PREVIEW_CACHE=/code/photo-previews
PHOTO_PREVIEW_TTL_DAYS=1
PHOTO_PREVIEW_CACHE_MAX_BYTES=104857600
