{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TouchGrass UAT Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "personas", "priority", "routes", "viewports", "themes", "prerequisites", "steps", "expected", "mutations", "cleanup", "evidence_required", "tags", "enabled"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "personas": { "type": "array", "minItems": 1, "items": { "enum": ["A", "B", "C", "D", "E", "F"] } },
    "priority": { "enum": ["critical", "high", "normal"] },
    "routes": { "type": "array", "items": { "type": "string" } },
    "viewports": { "type": "array", "items": { "enum": ["desktop", "iphone-portrait", "iphone-landscape", "zoom-200"] } },
    "themes": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expected": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "mutations": { "type": "array", "items": { "type": "string" } },
    "cleanup": { "type": "array", "items": { "type": "string" } },
    "evidence_required": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "cross_account": { "type": "boolean", "default": false },
    "destructive": { "type": "boolean", "default": false },
    "enabled": { "type": "boolean" }
  }
}
